From d424cfded0d6a4f81185833c528a283b31e7b158 Mon Sep 17 00:00:00 2001
From: daily-max <daily-max@users.noreply.github.com>
Date: Wed, 25 Nov 2026 06:46:23 +0000
Subject: [PATCH] style: retheme Pathfinder to Neon Sentinel

Swap the teal palette for the Neon Sentinel cyberpunk scheme: deep
blue-black surfaces, cyan data glow on walls, player and grid, and ember
orange-red accents for the goal and solution path. Layout, gameplay and
a11y semantics are unchanged.
---
 Pathfinder.html | 63 ++++++++++++++++++++++++++++++-------------------
 Pathfinder.md   |  4 +++-
 2 files changed, 42 insertions(+), 25 deletions(-)

diff --git a/Pathfinder.html b/Pathfinder.html
index 3038851..fa79070 100644
--- a/Pathfinder.html
+++ b/Pathfinder.html
@@ -3,28 +3,28 @@
 <head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
-<meta name="theme-color" content="#016563">
-<title>Pathfinder</title>
+<meta name="theme-color" content="#05070f">
+<title>Pathfinder — Neon Sentinel</title>
 <style>
-:root{--bg:#016563;--ink:#fff;--green:#00cc00;--red:#f00}
+:root{--bg:#05070f;--ink:#d7f2ff;--cyan:#22d3ee;--ember:#ff4d2d;--green:#22d3ee;--red:#ff4d2d}
 *{box-sizing:border-box}
 html,body{height:100%}
-body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
+body{margin:0;background:radial-gradient(125% 95% at 50% 0%,#0d1a2e 0%,#070c18 45%,#010206 100%) fixed;color:var(--ink);font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;-webkit-font-smoothing:antialiased;
 padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px);
 -webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;overflow:hidden}
 .app{display:flex;flex-direction:column;height:100%;max-width:560px;margin:0 auto;padding:6px 16px 10px}
 .bar{display:flex;align-items:center;justify-content:space-between;height:52px;flex:none}
 .icon{background:none;border:0;color:var(--ink);padding:10px;margin:-10px;cursor:pointer;border-radius:10px;display:grid;place-items:center}
-.icon:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
+.icon:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;box-shadow:0 0 12px rgba(34,211,238,.55)}
 .burger{display:block;width:34px}
-.burger i{display:block;height:5px;border-radius:3px;background:currentColor;margin:6px 0}
+.burger i{display:block;height:5px;border-radius:3px;background:currentColor;margin:6px 0;box-shadow:0 0 8px rgba(34,211,238,.75)}
 .burger i:last-child{margin-bottom:0}
 #stage{flex:1;display:grid;place-items:center;min-height:0;position:relative}
 #maze{display:block;touch-action:none}
-#toast{position:absolute;left:0;right:0;bottom:2px;text-align:center;font-weight:600;min-height:1.3em;pointer-events:none}
+#toast{position:absolute;left:0;right:0;bottom:2px;text-align:center;font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:.82rem;color:var(--cyan);text-shadow:0 0 10px rgba(34,211,238,.7);min-height:1.3em;pointer-events:none}
 .pad{display:grid;grid-template-columns:repeat(3,62px);grid-template-rows:repeat(3,62px);justify-content:center;flex:none;padding-top:8px}
 .pad button{background:none;border:0;padding:0;cursor:pointer;display:grid;place-items:center;border-radius:10px}
-.pad button::before{content:"";width:44px;height:44px;background:var(--ink);clip-path:polygon(50% 0,100% 100%,0 100%)}
+.pad button::before{content:"";width:44px;height:44px;background:var(--cyan);clip-path:polygon(50% 0,100% 100%,0 100%);filter:drop-shadow(0 0 7px rgba(34,211,238,.8))}
 .pad [data-dir="up"]{grid-area:1/2}
 .pad [data-dir="left"]{grid-area:2/1}
 .pad [data-dir="right"]{grid-area:2/3}
@@ -33,14 +33,15 @@ padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-are
 .pad [data-dir="right"]::before{transform:rotate(90deg)}
 .pad [data-dir="down"]::before{transform:rotate(180deg)}
 .pad button:active::before{opacity:.55}
-.pad button:focus-visible{outline:3px solid var(--ink);outline-offset:0}
-.sheet{position:fixed;inset:0;background:rgba(0,0,0,.6);display:grid;place-items:start center;padding:72px 20px;z-index:10}
+.pad button:focus-visible{outline:2px solid var(--ember);outline-offset:0;box-shadow:0 0 12px rgba(255,77,45,.55)}
+.sheet{position:fixed;inset:0;background:rgba(2,5,12,.82);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);display:grid;place-items:start center;padding:72px 20px;z-index:10}
 .sheet[hidden]{display:none}
-.panel{width:100%;max-width:340px;background:var(--bg);border:2px solid var(--ink);border-radius:16px;padding:18px;display:grid;gap:10px}
-.panel h2{margin:0 0 2px;font-size:1.05rem;font-weight:700;letter-spacing:.02em}
-.panel .result{margin:0;font-weight:600;color:var(--green)}
-.panel button{font:inherit;font-weight:600;color:var(--ink);background:none;border:2px solid var(--ink);border-radius:12px;padding:12px;cursor:pointer}
-.panel button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
+.panel{width:100%;max-width:340px;background:linear-gradient(180deg,#0b1526 0%,#060b16 100%);border:1px solid rgba(34,211,238,.55);border-radius:14px;padding:18px;display:grid;gap:10px;box-shadow:0 0 0 1px rgba(34,211,238,.12),0 0 32px rgba(34,211,238,.22),inset 0 1px 0 rgba(215,242,255,.08)}
+.panel h2{margin:0 0 2px;font-size:1.05rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);text-shadow:0 0 12px rgba(34,211,238,.65)}
+.panel .result{margin:0;font-weight:600;color:var(--ember);text-shadow:0 0 10px rgba(255,77,45,.6)}
+.panel button{font:inherit;font-weight:600;letter-spacing:.06em;color:var(--cyan);background:rgba(34,211,238,.06);border:1px solid rgba(34,211,238,.5);border-radius:10px;padding:12px;cursor:pointer;transition:box-shadow .15s,background .15s}
+.panel button:hover{background:rgba(34,211,238,.14);box-shadow:0 0 14px rgba(34,211,238,.35)}
+.panel button[aria-pressed="true"]{background:var(--cyan);border-color:var(--cyan);color:#03121a;box-shadow:0 0 18px rgba(34,211,238,.65)}
 .panel .row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
 .panel .row button{padding:10px 0;font-size:.9rem}
 </style>
@@ -90,7 +91,7 @@ padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-are
 </div>
 
 <script>
-const BG='#016563',INK='#fff',GREEN='#00cc00',RED='#ff0000';
+const BG='#05070f',INK='#d7f2ff',CYAN='#22d3ee',EMBER='#ff4d2d',WALL='#5ee9ff',GREEN='#22d3ee',RED='#ff4d2d';
 const LEVELS={easy:11,medium:15,hard:21};
 const DIRS={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]};
 
@@ -199,28 +200,42 @@ function render(){
   ctx.setTransform(dpr,0,0,dpr,0,0);
   ctx.clearRect(0,0,size,size);
   const s=size/n,lw=Math.max(2,s*.075),half=lw/2;
-  ctx.lineCap='square';ctx.lineWidth=lw;ctx.strokeStyle=INK;
+  ctx.save();
+  ctx.strokeStyle='rgba(34,211,238,.10)';ctx.lineWidth=1;
+  ctx.beginPath();
+  for(let i=1;i<n;i++){ctx.moveTo(i*s,0);ctx.lineTo(i*s,size);ctx.moveTo(0,i*s);ctx.lineTo(size,i*s)}
+  ctx.stroke();ctx.restore();
+  ctx.save();
+  ctx.lineCap='square';ctx.lineWidth=lw;ctx.strokeStyle=WALL;
+  ctx.shadowColor='rgba(34,211,238,.75)';ctx.shadowBlur=lw*1.8;
   ctx.strokeRect(half,half,size-lw,size-lw);
   ctx.beginPath();
   for(let y=0;y<n;y++)for(let x=0;x<n;x++){
     if(y>0&&wallN[y][x]){ctx.moveTo(x*s,y*s);ctx.lineTo((x+1)*s,y*s)}
     if(x>0&&wallW[y][x]){ctx.moveTo(x*s,y*s);ctx.lineTo(x*s,(y+1)*s)}
   }
-  ctx.stroke();
+  ctx.stroke();ctx.restore();
   if(showSol&&sol.length>1){
-    ctx.save();ctx.globalAlpha=.5;ctx.lineWidth=Math.max(3,s*.15);ctx.lineJoin='round';ctx.lineCap='round';
+    ctx.save();ctx.globalAlpha=.55;ctx.lineWidth=Math.max(3,s*.14);ctx.lineJoin='round';ctx.lineCap='round';
+    ctx.strokeStyle=EMBER;ctx.shadowColor='rgba(255,77,45,.85)';ctx.shadowBlur=s*.5;
+    ctx.setLineDash([s*.22,s*.22]);
     ctx.beginPath();
     sol.forEach((c,i)=>{const px=(cx(c)+.5)*s,py=(cy(c)+.5)*s;i?ctx.lineTo(px,py):ctx.moveTo(px,py)});
     ctx.stroke();ctx.restore();
   }
   const barW=Math.max(5,s*.16);
-  ctx.lineCap='butt';ctx.lineWidth=barW;
-  ctx.strokeStyle=GREEN;
+  ctx.save();ctx.lineCap='butt';ctx.lineWidth=barW;
+  ctx.shadowBlur=barW*2.2;
+  ctx.shadowColor='rgba(34,211,238,.9)';ctx.strokeStyle=GREEN;
   ctx.beginPath();ctx.moveTo(cx(start)*s,half);ctx.lineTo((cx(start)+1)*s,half);ctx.stroke();
-  ctx.strokeStyle=RED;
+  ctx.shadowColor='rgba(255,77,45,.9)';ctx.strokeStyle=RED;
   ctx.beginPath();ctx.moveTo(cx(goal)*s,size-half);ctx.lineTo((cx(goal)+1)*s,size-half);ctx.stroke();
-  ctx.fillStyle=INK;
-  ctx.beginPath();ctx.arc((cx(pos)+.5)*s,(cy(pos)+.5)*s,s*.34,0,Math.PI*2);ctx.fill();
+  const px=(cx(pos)+.5)*s,py=(cy(pos)+.5)*s;
+  ctx.shadowColor='rgba(34,211,238,.95)';ctx.shadowBlur=s*.95;ctx.fillStyle=CYAN;
+  ctx.beginPath();ctx.arc(px,py,s*.34,0,Math.PI*2);ctx.fill();
+  ctx.shadowBlur=0;ctx.fillStyle='#f2ffff';
+  ctx.beginPath();ctx.arc(px,py,s*.16,0,Math.PI*2);ctx.fill();
+  ctx.restore();
 }
 
 function say(t){toast.textContent=t}
